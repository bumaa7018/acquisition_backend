# Application
APP_PORT=8080
APP_ENV=development
# Лог түвшин: debug | info | warn | error. Анхдагчаар "warn" (зөвхөн анхаарал татахуйц/алдаа лог) — дэлгэрэнгүй хэрэгтэй үед "info"/"debug" болгоно.
LOG_LEVEL=info

# Үндсэн DB — бизнесийн мэдээлэл
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=appdb
DB_SSLMODE=disable

# Auth DB — хэрэглэгч, эрх, нэвтрэх мэдээлэл
AUTH_DB_HOST=postgres_auth
AUTH_DB_PORT=5432
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
AUTH_DB_NAME=authdb
AUTH_DB_SSLMODE=disable

# JWT Secrets — change these in production!
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars

# Token TTLs
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Default admin credentials (created on first boot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# Default employee credentials (read-only land access)
EMPLOYEE_USERNAME=employee
EMPLOYEE_EMAIL=employee@example.com
EMPLOYEE_PASSWORD=Employee123!

# Default finance specialist credentials (compensation:* only)
FINANCE_USERNAME=finance
FINANCE_EMAIL=finance@example.com
FINANCE_PASSWORD=Admin123!

# Default professional organization credentials (compensation:* only)
PROF_ORG_USERNAME=prof_org
PROF_ORG_EMAIL=prof_org@example.com
PROF_ORG_PASSWORD=Admin123!

# Email (SMTP) — хоосон орхивол log-д л хэвлэнэ (dev mode)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@yourapp.com
# Frontend-ийн reset хуудасны URL — token эцэст нэмэгдэнэ
EMAIL_RESET_URL=http://localhost:3000/reset-password?token=

# Дундын сервис (ГУС middleware). Host дээр ажиллуулах үед localhost хэрэглэнэ.
# Docker compose дотор backend container-аас хандахдаа deployments/docker-compose.yml
# үүнийг http://goverment-middleware:8081 болгож override хийдэг.
MIDDLEWARE_BASE_URL=http://localhost:8081
MIDDLEWARE_USERNAME=government-api
MIDDLEWARE_PASSWORD=change_me_middleware_password

# Файлын систем (MinIO/S3) — системд оруулсан БҮХ файл (баримт, зураг, тайлан,
# дроны ортофото) эндээ хадгалагдана. API нь файлыг ӨӨР ДЭЭРЭЭ хадгалахгүй,
# зөвхөн object-ийн замыг (file_url) DB-д бичнэ.
#
# FILE_SERVER_BASE_URL нь ХАРЬЦАНГУЙ зам — frontend-ийн /api/files proxy үүнийг
# MinIO руу дамжуулна. Тиймээс host/port солигдоход DB-г хөндөх шаардлагагүй.
FILE_SERVER_MODE=s3
FILE_SERVER_BASE_URL=/api/files
S3_ENDPOINT=localhost:9000
# S3_GEOSERVER_ENDPOINT — GEOSERVER хандах хаяг (дроны растрыг HTTP Range-ээр
# шууд уншина). Container-т API ба GeoServer нэг сүлжээнд байдаг тул хоосон
# орхиж болно (S3_ENDPOINT хэрэглэгдэнэ). Харин API-г HOST дээр (air)
# ажиллуулах үед S3_ENDPOINT=localhost:9000 болох ба GeoServer container-аас
# "localhost" нь ӨӨРИЙГӨӨ заах тул дотоод хаягийг зааж өгнө:
#   S3_GEOSERVER_ENDPOINT=http://minio:9000
S3_GEOSERVER_ENDPOINT=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gov-files
S3_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Хуучин локал хадгалалт — зөвхөн ШИЛЖҮҮЛЭЛТЭД (000016_file_storage_migration)
# хэрэглэгдэнэ. Шилжүүлэлт дуусмагц шаардлагагүй.
FILE_SERVER_LOCAL_DIR=uploads/mock-file-server
LEGACY_FILE_BASE_URL=http://localhost:8080/mock-files

# Grafana (лог харах, deployments/docker-compose.logging.yml) — production дээр заавал солих!
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# GeoServer — дроны ортофото (.tif) давхарга.
#
# Зураг тус бүр өөрийн COG давхаргатай (`land:drone_<нэр>`): GeoServer растрыг
# ФАЙЛЫН СИСТЕМЭЭС (MinIO) HTTP Range хүсэлтээр ШУУД уншина. Backend растрыг
# өөр дээрээ хадгалахгүй, хуваалцсан хавтас ч байхгүй.
#
# WORKSPACE нь аль хэдийн байх ёстой (government-geoserver: make config).
# Давхаргыг API өөрөө үүсгэнэ — гар тохиргоо шаардахгүй.
GEOSERVER_URL=http://localhost:8600/geoserver
GEOSERVER_ADMIN=admin
GEOSERVER_PASS=geoserver
GEOSERVER_WORKSPACE=land
