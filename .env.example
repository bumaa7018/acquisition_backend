# Application
APP_PORT=8080
APP_ENV=development
# Лог түвшин: debug | info | warn | error. Анхдагчаар "warn" (зөвхөн анхаарал татахуйц/алдаа лог) — дэлгэрэнгүй хэрэгтэй үед "info"/"debug" болгоно.
LOG_LEVEL=info

# Үндсэн DB — бизнесийн мэдээлэл
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=appdb
DB_SSLMODE=disable

# Auth DB — хэрэглэгч, эрх, нэвтрэх мэдээлэл
AUTH_DB_HOST=postgres_auth
AUTH_DB_PORT=5432
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
AUTH_DB_NAME=authdb
AUTH_DB_SSLMODE=disable

# JWT Secrets — change these in production!
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars

# Token TTLs
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Default admin credentials (created on first boot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# Default employee credentials (read-only land access)
EMPLOYEE_USERNAME=employee
EMPLOYEE_EMAIL=employee@example.com
EMPLOYEE_PASSWORD=Employee123!

# Default finance specialist credentials (compensation:* only)
FINANCE_USERNAME=finance
FINANCE_EMAIL=finance@example.com
FINANCE_PASSWORD=Admin123!

# Default professional organization credentials (compensation:* only)
PROF_ORG_USERNAME=prof_org
PROF_ORG_EMAIL=prof_org@example.com
PROF_ORG_PASSWORD=Admin123!

# Email (SMTP) — хоосон орхивол log-д л хэвлэнэ (dev mode)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@yourapp.com
# Frontend-ийн reset хуудасны URL — token эцэст нэмэгдэнэ
EMAIL_RESET_URL=http://localhost:3000/reset-password?token=

# File server
FILE_SERVER_MODE=mock
FILE_SERVER_BASE_URL=http://localhost:8080/mock-files
FILE_SERVER_LOCAL_DIR=uploads/mock-file-server

# Grafana (лог харах, deployments/docker-compose.logging.yml) — production дээр заавал солих!
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
