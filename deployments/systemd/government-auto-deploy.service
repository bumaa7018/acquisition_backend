[Unit]
Description=Government backend auto deploy
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/government
Environment=ROOT_DIR=/home/deploy/government
Environment=GIT_REMOTE=origin
Environment=GIT_BRANCH=main
ExecStart=/home/deploy/government/scripts/deploy-on-change.sh
